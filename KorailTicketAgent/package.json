{
  "name": "korail-ticket-agent",
  "version": "1.0.0",
  "description": "Desktop GUI & EXE for Korail Train Ticket Reservation & Telegram Alert",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "search-train": "tsx src/korail_agent.ts",
    "package-exe": "tsc && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.korail.ticketagent",
    "productName": "KorailTicketAgent",
    "asar": false,
    "win": {
      "target": "dir"
    },
    "files": [
      "dist/**/*",
      "src/ui/**/*",
      "node_modules/**/*",
      "package.json",
      ".env"
    ]
  },
  "dependencies": {
    "call-bind-apply-helpers": "^1.0.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "node-telegram-bot-api": "^0.66.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/node-telegram-bot-api": "^0.64.7",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
